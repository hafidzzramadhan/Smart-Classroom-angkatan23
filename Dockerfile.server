FROM python:3.11-slim

# libgl1 & libglib2.0-0: dibutuhkan opencv (dependensi ultralytics)
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch versi CPU saja (server tidak punya GPU) supaya image tidak membengkak
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Opsional: dukungan encoding wajah (dlib dikompilasi dari source: LAMA dan butuh RAM).
#   docker build --build-arg WITH_RECOGNITION=1 ...
ARG WITH_RECOGNITION=0
RUN if [ "$WITH_RECOGNITION" = "1" ]; then \
      apt-get update && apt-get install -y --no-install-recommends build-essential cmake && \
      MAKEFLAGS=-j1 pip install --no-cache-dir "setuptools<81" wheel dlib face_recognition && \
      apt-get purge -y build-essential cmake && apt-get autoremove -y && \
      rm -rf /var/lib/apt/lists/*; \
    fi

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/app.py server/face_gallery.py server/enroll_face.py ./
COPY src/smartclass_cv/smartclass_cv/recognition_match.py smartclass_cv/

# Model TIDAK ada di image; dipasang sebagai volume read-only di /models
ENV EXPRESSION_MODEL=/models/best.pt \
    ACTIVITY_MODEL=/models/best.onnx \
    OMP_NUM_THREADS=1

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
